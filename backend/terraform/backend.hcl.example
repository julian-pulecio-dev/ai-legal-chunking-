# Copy to backend.hcl (gitignored) and fill in the bucket name of your existing
# S3 bucket for Terraform state, then run:
#   terraform init -backend-config=backend.hcl
bucket       = "<your-existing-tfstate-bucket-name>"
key          = "ai-legal-chunking/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
